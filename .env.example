# =============================================================
# RateIT India — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase (https://supabase.com — free tier)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database (provided by Supabase)
DATABASE_URL=your-supabase-postgres-connection-string

# Google Maps Platform (https://console.cloud.google.com — $200/mo free credit)
# Used for geofencing and place search
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Upstash Redis (https://upstash.com — free tier)
# Used for hard API rate-limiting on review submissions and OTP requests
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Cloudflare Turnstile (https://dash.cloudflare.com/ — free)
# Used for abuse prevention on the OTP endpoint
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
